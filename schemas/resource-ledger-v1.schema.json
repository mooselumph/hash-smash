{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource bounds before pricing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "success_probability", "coverage", "components"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["resource-ledger-v1"]},
    "success_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage": {"type": "string", "minLength": 1},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "phase", "operation", "count_log2", "bound_kind", "status", "source_weights", "evidence", "assumptions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "enum": ["target_compression", "word_operation", "opaque"]},
          "count_log2": {"type": "number", "minimum": 0},
          "bound_kind": {"type": "string", "enum": ["exact", "upper_bound", "estimate"]},
          "status": {"type": "string", "enum": ["supported", "conditional", "unresolved"]},
          "source_weights": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["target_compression", "word_operation"],
            "properties": {
              "target_compression": {"type": "number", "enum": [1]},
              "word_operation": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
          "assumptions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
